<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Rag</PackageId>
    <Version>1.4.3</Version>
    <PackageReleaseNotes>v1.4.3: Cached CSR HippoRAG PPR reranking, numeric acronym false-positive guard, chunk overlap floor, and aligned Graph/Inference/Vector deps.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 in-process GraphRAG engine. Unifies dense SIMD vector search (Glacier.Vector) and zero-allocation CSR knowledge graph traversal (Glacier.Graph) directly with native LLM inference (Glacier.Inference) in a single memory space. Replaces Python LangChain, LlamaIndex, Chroma, and Neo4j.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Rag</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Rag.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>rag;graphrag;llm;vector-search;knowledge-graph;semantic-search;csharp;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Vector" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Graph" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' != 'false'">
    <ProjectReference Include="../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' == 'false'">
    <PackageReference Include="Glacier.Inference" Version="1.10.1" />
  </ItemGroup>
</Project>
